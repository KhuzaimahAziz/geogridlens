# Local Python environment and notebook state
.venv/
.ipynb_checkpoints/
__pycache__/
*.py[cod]

# Local datasets, checkpoints, runs, and generated results
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/spatial/*
!data/spatial/.gitkeep
models/*
!models/.gitkeep
outputs/*
!outputs/**/.gitkeep
mlruns/

# Editor and OS files
.vscode/
.DS_Store

# Keep the geodata provenance record even though raw downloads are ignored
!data/raw/alentejo/
data/raw/alentejo/*
!data/raw/alentejo/geodata_sources.json
# Figures are published from docs/figures; outputs/figures is regenerated
!data/spatial/case_study/
data/spatial/case_study/*
!data/spatial/case_study/spatial_metadata.json
!data/spatial/case_study/contingencies.csv

# Artefacts needed by the hosted read-only dashboard (small, regenerated by the pipeline)
!data/spatial/case_study/*.parquet
!outputs/case_study/
outputs/case_study/*
!outputs/case_study/scenario_manifest.csv
!outputs/case_study/indicators/
!outputs/case_study/indicators/*.parquet
!outputs/case_study/indicators/*.csv
!outputs/case_study/genco_results/
outputs/case_study/genco_results/*
!outputs/case_study/genco_results/*.parquet
!outputs/case_study/genco_results/scenario_manifest.csv
!outputs/case_study/ac_validation/
outputs/case_study/ac_validation/*
!outputs/case_study/ac_validation/*.csv
!outputs/case_study/ac_validation/*.parquet
!outputs/case_study/capacity_sweep/
outputs/case_study/capacity_sweep/*
!outputs/case_study/capacity_sweep/capacity_sweep.csv
